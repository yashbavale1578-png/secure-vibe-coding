{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Security finding",
  "type": "object",
  "required": [
    "id",
    "title",
    "severity",
    "confidence",
    "status",
    "description",
    "evidence",
    "recommendation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SEC-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "Critical",
        "High",
        "Medium",
        "Low",
        "Informational"
      ]
    },
    "confidence": {
      "enum": [
        "High",
        "Medium",
        "Low"
      ]
    },
    "status": {
      "enum": [
        "Confirmed",
        "Likely",
        "Needs validation",
        "Not verified",
        "Fixed",
        "Accepted risk"
      ]
    },
    "description": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "excerpt_redacted": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    "recommendation": {
      "type": "string"
    },
    "verification": {
      "type": "string"
    },
    "residual_risk": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
